# Mirakurun server URL
MIRAKURUN_URL=http://tuner:40772
FUBA_RECORDER_API_URL=http://127.0.0.1:37569

# Program guide service
PROGRAM_API_URL=http://puma2:40870

# Server port
PORT=8080

# Gin mode (debug/release)
GIN_MODE=release

# Resource and timeout defaults
MAX_VIEWERS=4
MAX_CHANNEL_SESSIONS=1
MAX_HTTP_CONCURRENCY=32
HTTP_REQUEST_TIMEOUT_SECONDS=5
STREAM_CONNECT_TIMEOUT_SECONDS=10
EPG_CACHE_TTL_SECONDS=30

# Optional VoiceTranslate integration. Set this to an absolute host path and
# start Compose with compose.translation.yml. Never put the token itself here.
VOICETRANSLATE_TOKEN_FILE=
VOICETRANSLATE_URL=
VOICETRANSLATE_ORIGIN=

# Optional public browser origins, comma-separated. Keep private deployment
# hostnames in the untracked .env file instead of committing them.
ALLOWED_ORIGINS=
